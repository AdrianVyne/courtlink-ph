{
  "name": "@courtlink/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "biome lint src",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/s3-request-presigner": "3.1105.0",
    "@courtlink/database": "workspace:*",
    "@courtlink/domain": "workspace:*",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "9.1.3",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "argon2": "0.45.1",
    "bullmq": "5.79.2",
    "dotenv": "17.4.2",
    "fastify": "5.11.2",
    "google-auth-library": "10.9.0",
    "ioredis": "5.11.1",
    "nodemailer": "^9.0.5",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
